{
  "signatures": [
    {
      "name": "DeepMLP_Norm_Act",
      "category": "mlp",
      "domain": "custom.pytorch",
      "description": "Pre-norm followed by Linear projection and Activation function",
      "inputs": ["x", "norm_weight", "norm_bias", "linear_weight", "linear_bias"],
      "outputs": ["out"],
      "sub_ops": ["LayerNorm", "Linear", "Gelu"],
      "attributes": {
        "activation": "GELU",
        "has_norm": true
      }
    },
    {
      "name": "ResMLP_Block",
      "category": "mlp",
      "domain": "custom.pytorch",
      "description": "Cross-token affine transform with residual addition and channel MLP",
      "inputs": ["x", "affine_weight", "affine_bias", "mlp_w1", "mlp_b1", "mlp_w2", "mlp_b2"],
      "outputs": ["out"],
      "sub_ops": ["Linear", "Add", "Gelu"],
      "attributes": {
        "has_residual": true
      }
    },
    {
      "name": "MLPMixer_Block",
      "category": "mlp",
      "domain": "custom.pytorch",
      "description": "Token-mixing MLP followed by channel-mixing MLP with residual connections",
      "inputs": ["x", "token_w1", "token_b1", "token_w2", "token_b2", "chan_w1", "chan_b1", "chan_w2", "chan_b2"],
      "outputs": ["out"],
      "sub_ops": ["LayerNorm", "Linear", "Gelu", "Add"],
      "attributes": {
        "has_token_mixing": true,
        "has_channel_mixing": true
      }
    },
    {
      "name": "SpatialGatingUnit",
      "category": "mlp",
      "domain": "custom.pytorch",
      "description": "gMLP Spatial Gating Unit splitting channels and gating via spatial projection",
      "inputs": ["x", "weight", "bias"],
      "outputs": ["out"],
      "sub_ops": ["Split", "LayerNorm", "Linear", "Mul"],
      "attributes": {
        "dim": -1
      }
    },
    {
      "name": "HighwayBlock",
      "category": "mlp",
      "domain": "custom.pytorch",
      "description": "Highway Network block with Transform and Carry gating",
      "inputs": ["x", "w_h", "b_h", "w_t", "b_t"],
