      "sub_ops": ["Linear", "Sigmoid", "Mul", "Sub", "Add"],
      "attributes": {
        "activation": "ReLU"
      }
    },
    {
      "name": "SqueezeExcitation",
      "category": "vision",
      "domain": "custom.pytorch",
      "description": "Channel-wise Squeeze-and-Excitation attention mechanism",
      "inputs": ["x", "fc1_w", "fc1_b", "fc2_w", "fc2_b"],
      "outputs": ["out"],
      "sub_ops": ["GlobalAveragePool", "Linear", "Relu", "Sigmoid", "Mul"],
      "attributes": {
        "reduction_ratio": 4
      }
    },
    {
      "name": "InvertedResidualBlock",
      "category": "vision",
      "domain": "custom.pytorch",
      "description": "MobileNetV2/V3 Inverted Residual block with depthwise separable convolution",
      "inputs": ["x", "expand_w", "dw_w", "proj_w"],
      "outputs": ["out"],
      "sub_ops": ["Conv", "Relu6", "Conv", "Add"],
      "attributes": {
        "has_residual": true
      }
    },
    {
      "name": "ConvNeXtBlock",
      "category": "vision",
      "domain": "custom.pytorch",
      "description": "Modern ConvNeXt 7x7 depthwise convolution with inverted MLP bottleneck",
      "inputs": ["x", "dw_w", "dw_b", "norm_w", "norm_b", "pw1_w", "pw1_b", "pw2_w", "pw2_b"],
      "outputs": ["out"],
      "sub_ops": ["Conv", "LayerNorm", "Linear", "Gelu", "Add"],
      "attributes": {
        "kernel_size": 7
      }
    },
    {
      "name": "MultiHeadAttention",
      "category": "transformer",
      "domain": "custom.pytorch",
      "description": "Composite Multi-Head Attention block combining QKV projection, SDPA, and Out projection",
      "inputs": ["x", "qkv_weight", "qkv_bias", "out_weight", "out_bias"],
      "outputs": ["out"],
      "sub_ops": ["Linear", "SplitQKV", "ScaledDotProductAttention", "MergeHeads"],
      "attributes": {
        "num_heads": 4
      }
    },
    {
      "name": "DiT_Block",
      "category": "diffusion",
      "domain": "custom.pytorch",
      "description": "Diffusion Transformer block with adaptive LayerNorm conditioning and zero-init gating",
      "inputs": ["x", "c", "attn_w", "mlp_w", "ada_w"],
      "outputs": ["out"],
      "sub_ops": ["Linear", "LayerNorm", "ScaledDotProductAttention", "Mul", "Add"],
      "attributes": {
        "has_adaln": true
      }
    },
    {
      "name": "MambaSSM",
      "category": "ssm",
      "domain": "custom.pytorch",
      "description": "Selective State Space Model (S6) block with dynamic discretization and 1D convolution",
