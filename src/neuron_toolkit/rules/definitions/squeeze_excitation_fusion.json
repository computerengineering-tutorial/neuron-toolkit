{
  "rule_id": "squeeze_excitation_fusion",
  "name": "Squeeze-and-Excitation (SE) Block Fusion",
  "description": "Fuses GAP -> FC1 -> Relu -> FC2 -> Sigmoid -> Mul into SqueezeExcitation macro block with FunctionProto Netron expandability.",
  "pattern": {
    "nodes": [
      {
        "id": "gap",
        "op_type": "GlobalAveragePool|ReduceMean",
        "inputs": [
          "$x"
        ],
        "outputs": [
          "$gap_out"
        ]
      },
      {
        "id": "fc1",
        "op_type": "Conv|Linear|Gemm",
        "inputs": [
          "$gap_out",
          "$w1"
        ],
        "outputs": [
          "$fc1_out"
        ]
      },
      {
        "id": "act",
        "op_type": "Relu",
        "inputs": [
          "$fc1_out"
        ],
        "outputs": [
          "$act_out"
        ]
      },
      {
        "id": "fc2",
        "op_type": "Conv|Linear|Gemm",
        "inputs": [
          "$act_out",
          "$w2"
        ],
        "outputs": [
          "$fc2_out"
        ]
      },
      {
        "id": "sig",
        "op_type": "Sigmoid",
        "inputs": [
          "$fc2_out"
        ],
        "outputs": [
          "$scale"
        ]
      },
      {
        "id": "mul",
        "op_type": "Mul",
        "inputs": [
          "$x",
          "$scale"
        ],
        "outputs": [
          "$final_out"
        ]
      }
    ]
  },
  "action": {
    "type": "fuse_to_function",
    "op_type": "SqueezeExcitation",
    "domain": "custom.pytorch",
    "inputs": [
      "$x",
      "$w1",
      "$w2"
    ],
    "outputs": [
      "$final_out"
    ],
    "targets": {
      "function_proto": {
        "op_type": "SqueezeExcitation",
        "domain": "custom.pytorch",
        "inputs": [
          "$x",
          "$w1",
          "$w2"
        ]
      }
    }
  }
}
