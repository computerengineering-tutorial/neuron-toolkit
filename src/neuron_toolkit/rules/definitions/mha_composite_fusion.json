{
  "rule_id": "mha_composite_fusion",
  "name": "Multi-Head Attention Composite Fusion",
  "description": "Fuses Linear(QKV) -> SplitQKV -> SDPA -> MergeHeads -> Linear(Out) into MultiHeadAttention with FunctionProto Netron expandability.",
  "pattern": {
    "nodes": [
      {
        "id": "qkv",
        "op_type": "Linear|Gemm|MatMul",
        "inputs": [
          "$x",
          "$w_qkv"
        ],
        "outputs": [
          "$qkv_out"
        ]
      },
      {
        "id": "sdpa",
        "op_type": "SDPA|ScaledDotProductAttention",
        "inputs": [
          "$qkv_out"
        ],
        "outputs": [
          "$sdpa_out"
        ]
      },
      {
        "id": "merge",
        "op_type": "MergeHeads",
        "inputs": [
          "$sdpa_out"
        ],
        "outputs": [
          "$merged_out"
        ]
      },
      {
        "id": "out_proj",
        "op_type": "Linear|Gemm|MatMul",
        "inputs": [
          "$merged_out",
          "$w_out"
        ],
        "outputs": [
          "$final_out"
        ]
      }
    ]
  },
  "action": {
    "type": "fuse_to_function",
    "op_type": "MultiHeadAttention",
    "domain": "custom.pytorch",
    "inputs": [
      "$x",
      "$w_qkv",
      "$w_out"
    ],
    "outputs": [
      "$final_out"
    ],
    "targets": {
      "function_proto": {
        "op_type": "MultiHeadAttention",
        "domain": "custom.pytorch",
        "inputs": [
          "$x",
          "$w_qkv",
          "$w_out"
        ]
      }
    }
  }
}
