{
  "rule_id": "linear_fusion",
  "version": "1.0",
  "name": "Linear Layer Fusion",
  "description": "Fuses MatMul(X, W) + bias into a single high-level Linear operator under custom.pytorch domain.",
  "source_pattern": {
    "nodes": [
      {
        "id": "mm",
        "op_type": "MatMul",
        "inputs": ["X", "W"],
        "outputs": ["MM"]
      },
      {
        "id": "add",
        "op_type": "Add",
        "inputs": ["MM", "bias"],
        "outputs": ["Y"]
      }
    ],
    "constraints": [
      "bias in graph.initializer",
      "count_users(MM) == 1"
    ]
  },
  "target_pattern": {
    "nodes": [
      {
        "op_type": "Linear",
        "domain": "custom.pytorch",
        "inputs": ["X", "W", "bias"],
        "outputs": ["Y"]
      }
    ]
  }
}
