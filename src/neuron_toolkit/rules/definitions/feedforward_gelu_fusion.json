{
  "rule_id": "feedforward_gelu_fusion",
  "name": "FeedForward GELU Block Fusion",
  "description": "Fuses 4-node FeedForward / MLP block (RMSNorm -> Linear -> Gelu -> Linear) into an interpretable FeedForward block with FunctionProto Netron expandability.",
  "pattern": {
    "nodes": [
      {
        "id": "norm_node",
        "op_type": "RMSNorm",
        "inputs": ["$x", "$norm_w"],
        "outputs": ["$norm_out"]
      },
      {
        "id": "fc1_node",
        "op_type": "Linear",
        "inputs": ["$norm_out", "$fc1_w", "$fc1_b"],
        "outputs": ["$fc1_out"]
      },
      {
        "id": "gelu_node",
        "op_type": "Gelu",
        "inputs": ["$fc1_out"],
        "outputs": ["$act_out"]
      },
      {
        "id": "fc2_node",
        "op_type": "Linear",
        "inputs": ["$act_out", "$fc2_w", "$fc2_b"],
        "outputs": ["$final_out"]
      }
    ]
  },
  "action": {
    "type": "fuse_to_function",
    "op_type": "FeedForward",
    "domain": "custom.pytorch",
    "inputs": ["$x", "$norm_w", "$fc1_w", "$fc1_b", "$fc2_w", "$fc2_b"],
    "outputs": ["$final_out"],
    "attributes": {
      "activation": "gelu"
    },
    "targets": {
      "modern_onnx": {
        "op_type": "FeedForward",
        "domain": "custom.pytorch",
        "inputs": ["$x", "$norm_w", "$fc1_w", "$fc1_b", "$fc2_w", "$fc2_b"]
      },
      "function_proto": {
        "op_type": "FeedForward",
        "domain": "custom.pytorch",
        "inputs": ["$x", "$norm_w", "$fc1_w", "$fc1_b", "$fc2_w", "$fc2_b"]
      },
      "pytorch_custom": {
        "op_type": "FeedForward",
        "domain": "custom.pytorch",
        "inputs": ["$x", "$norm_w", "$fc1_w", "$fc1_b", "$fc2_w", "$fc2_b"]
      }
    }
  }
}
