{
  "rule_id": "tanh_gelu_canonicalization",
  "name": "Tanh GELU Approximation Canonicalization",
  "description": "Fuses 10-node polynomial Tanh approximation into standard Gelu(approximate='tanh').",
  "pattern": {
    "nodes": [
      {
        "id": "tanh_node",
        "op_type": "Tanh",
        "inputs": [
          "$tanh_in"
        ],
        "outputs": [
          "$tanh_out"
        ]
      },
      {
        "id": "add_node",
        "op_type": "Add",
        "inputs": [
          "$tanh_out",
          "$c_one"
        ],
        "outputs": [
          "$add_out"
        ]
      },
      {
        "id": "mul_x_node",
        "op_type": "Mul",
        "inputs": [
          "$x",
          "$add_out"
        ],
        "outputs": [
          "$mul_x_out"
        ]
      },
      {
        "id": "mul_half_node",
        "op_type": "Mul",
        "inputs": [
          "$mul_x_out",
          "$c_half"
        ],
        "outputs": [
          "$y"
        ]
      }
    ]
  },
  "action": {
    "type": "replace_op",
    "op_type": "Gelu",
    "domain": "custom.pytorch",
    "inputs": [
      "$x"
    ],
    "outputs": [
      "$y"
    ],
    "attributes": {
      "approximate": "tanh"
    },
    "targets": {
      "function_proto": {
        "op_type": "Gelu",
        "domain": "custom.pytorch",
        "inputs": [
          "$x"
        ],
        "attributes": {
          "approximate": "tanh"
        }
      }
    }
  }
}
