{
  "rule_id": "multi_task_audio_head_fusion",
  "name": "Multi-Task Audio Decoder Head Composite Fusion",
  "description": "Fuses post-body dual-branch feature extractor (pitched + percussion) and multi-task prediction decoders into MultiTaskDecoderHead with FunctionProto expandability.",
  "pattern": {
    "nodes": [
      {
        "id": "body_exit",
        "op_type": "*",
        "inputs": [],
        "outputs": [
          "$x"
        ]
      }
    ]
  },
  "action": {
    "type": "fuse_to_function",
    "op_type": "MultiTaskDecoderHead",
    "domain": "custom.pytorch",
    "inputs": [
      "$x"
    ],
    "outputs": [
      "$outputs"
    ],
    "targets": {
      "function_proto": {
        "op_type": "MultiTaskDecoderHead",
        "domain": "custom.pytorch",
        "inputs": [
          "$x"
        ]
      }
    }
  }
}
