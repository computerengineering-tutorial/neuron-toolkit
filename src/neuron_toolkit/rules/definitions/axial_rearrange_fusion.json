{
  "rule_id": "axial_rearrange_fusion",
  "version": "1.0",
  "name": "Axial Conformer Rearrange Fusion",
  "description": "Fuses Conformer multi-node shape calculation pipelines and multi-axis permutations (freq_in, freq_to_time, time_to_conv, add_channel) into custom.pytorch::AxialRearrange.",
  "pattern": {
    "nodes": [
      {
        "id": "trans",
        "op_type": "Transpose",
        "inputs": ["$x"],
        "outputs": ["$t"]
      },
      {
        "id": "reshape",
        "op_type": "Reshape",
        "inputs": ["$t", "$shape"],
        "outputs": ["$y"]
      }
    ],
    "constraints": [
      "trans.perm in [[0, 3, 2, 1], [0, 2, 1, 3], [0, 3, 1, 2]]",
      "count_users(T) == 1"
    ]
  },
  "action": {
    "type": "replace_op",
    "op_type": "AxialRearrange",
    "domain": "custom.pytorch",
    "inputs": ["$x"],
    "outputs": ["$y"],
    "attributes": {
      "mode": "string"
    }
  }
}
