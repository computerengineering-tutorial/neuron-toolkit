{
  "rule_id": "dead_code_elimination",
  "name": "Dead Code Elimination",
  "description": "Recursively prunes unreachable and unused subgraphs that do not reach graph.output.",
  "pattern": {
    "nodes": [
      {
        "id": "dead_node",
        "op_type": "*",
        "inputs": ["$x"],
        "outputs": ["$unused_out"]
      }
    ]
  },
  "action": {
    "type": "remove_nodes",
    "targets": {
      "modern_onnx": {
        "action": "prune"
      },
      "function_proto": {
        "action": "prune"
      },
      "pytorch_custom": {
        "action": "prune"
      }
    }
  }
}
