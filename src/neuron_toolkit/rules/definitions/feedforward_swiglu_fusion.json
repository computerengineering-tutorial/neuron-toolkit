{
  "rule_id": "feedforward_swiglu_fusion",
  "name": "FeedForward SwiGLU Block Fusion",
  "description": "Fuses SwiGLU block (RMSNorm -> Linear_gate * SiLU * Linear_up -> Linear_down) into FeedForwardSwiGLU with FunctionProto.",
  "pattern": {
    "nodes": [
      {
        "id": "norm_node",
        "op_type": "RMSNorm",
        "inputs": ["$x", "$gamma"],
        "outputs": ["$x_norm"]
      },
      {
        "id": "gate_node",
        "op_type": "Linear",
        "inputs": ["$x_norm", "$w_gate"],
        "outputs": ["$h_gate"]
      },
      {
        "id": "up_node",
        "op_type": "Linear",
        "inputs": ["$x_norm", "$w_up"],
        "outputs": ["$h_up"]
      },
      {
        "id": "silu_node",
        "op_type": "SiLU",
        "inputs": ["$h_gate"],
        "outputs": ["$h_act"]
      },
      {
        "id": "mul_node",
        "op_type": "Mul",
        "inputs": ["$h_act", "$h_up"],
        "outputs": ["$h_mul"]
      },
      {
        "id": "down_node",
        "op_type": "Linear",
        "inputs": ["$h_mul", "$w_down"],
        "outputs": ["$y"]
      }
    ]
  },
  "action": {
    "type": "fuse_to_function",
    "op_type": "FeedForwardSwiGLU",
    "domain": "custom.pytorch",
    "inputs": ["$x", "$gamma", "$w_gate", "$w_up", "$w_down"],
    "outputs": ["$y"],
    "targets": {
      "modern_onnx": {
        "op_type": "FeedForwardSwiGLU",
        "domain": "custom.pytorch",
        "inputs": ["$x", "$gamma", "$w_gate", "$w_up", "$w_down"]
      },
      "function_proto": {
        "op_type": "FeedForwardSwiGLU",
        "domain": "custom.pytorch",
        "inputs": ["$x", "$gamma", "$w_gate", "$w_up", "$w_down"]
      },
      "pytorch_custom": {
        "op_type": "FeedForwardSwiGLU",
        "domain": "custom.pytorch",
        "inputs": ["$x", "$gamma", "$w_gate", "$w_up", "$w_down"]
      }
    }
  }
}
