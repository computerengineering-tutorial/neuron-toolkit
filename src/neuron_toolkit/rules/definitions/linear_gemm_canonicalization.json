{
  "rule_id": "linear_gemm_canonicalization",
  "name": "Gemm to Linear Canonicalization",
  "description": "Converts Gemm(X, W, B, transB=1) into canonical Linear(X, W_trans, B).",
  "pattern": {
    "nodes": [
      {
        "id": "gemm_node",
        "op_type": "Gemm",
        "inputs": [
          "$x",
          "$w",
          "$b"
        ],
        "outputs": [
          "$y"
        ],
        "attributes": {
          "transB": 1
        }
      }
    ],
    "conditions": [
      {
        "type": "is_initializer",
        "tensor": "$w"
      }
    ]
  },
  "action": {
    "type": "replace_op",
    "op_type": "Linear",
    "domain": "custom.pytorch",
    "inputs": [
      "$x",
      "$w",
      "$b"
    ],
    "outputs": [
      "$y"
    ],
    "targets": {
      "function_proto": {
        "op_type": "Linear",
        "domain": "custom.pytorch",
        "inputs": [
          "$x",
          "$w",
          "$b"
        ]
      }
    }
  }
}
