{
  "rule_id": "cast_conv_weight_folding",
  "description": "Folds redundant FP16/FP32 Cast nodes on Conv weights and biases directly into initializers",
  "pattern": {
    "nodes": [
      {
        "id": "cast_node",
        "op_type": "Cast",
        "inputs": ["$weight_raw"],
        "outputs": ["$conv_weight"]
      },
      {
        "id": "conv_node",
        "op_type": "Conv",
        "inputs": ["$input", "$conv_weight"],
        "outputs": ["$conv_out"]
      }
    ],
    "conditions": [
      {
        "type": "is_initializer",
        "tensor": "$weight_raw"
      }
    ]
  },
  "action": {
    "type": "cast_fold",
    "target_tensor": "$weight_raw",
    "cast_node": "cast_node",
    "consumer_node": "conv_node",
    "pytorch_module": "torch.nn.functional.conv2d"
  }
}
