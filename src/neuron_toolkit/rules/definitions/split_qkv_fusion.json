{
  "rule_id": "split_qkv_fusion",
  "version": "1.0",
  "name": "Split QKV Fusion",
  "description": "Fuses Reshape -> Transpose(perm=[2, 0, 3, 1, 4]) -> Unbind (or Split) into custom.pytorch::SplitQKV, unpacking projected QKV activations into distinct [Q, K, V] tensors.",
  "pattern": {
    "nodes": [
      {
        "id": "reshape",
        "op_type": "Reshape",
        "inputs": ["$qkv", "$shape"],
        "outputs": ["$r"]
      },
      {
        "id": "trans",
        "op_type": "Transpose",
        "inputs": ["$r"],
        "outputs": ["$t"]
      },
      {
        "id": "unbind",
        "op_type": "Unbind",
        "inputs": ["$t"],
        "outputs": ["$q", "$k", "$v"]
      }
    ],
    "constraints": [
      "trans.perm == [2, 0, 3, 1, 4]",
      "count_users(R) == 1",
      "count_users(T) == 1"
    ]
  },
  "action": {
    "type": "replace_op",
    "op_type": "SplitQKV",
    "domain": "custom.pytorch",
    "inputs": ["$qkv"],
    "outputs": ["$q", "$k", "$v"],
    "attributes": {
      "num_heads": "@inferred_heads"
    }
  }
}
