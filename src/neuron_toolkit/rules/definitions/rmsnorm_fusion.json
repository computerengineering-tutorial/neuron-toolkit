{
  "rule_id": "rmsnorm_fusion",
  "description": "Fuses 9-node RMSNorm expansion (ReduceL2 -> Clip -> Expand -> Div -> Mul -> Mul) into a single RMSNorm function op",
  "pattern": {
    "nodes": [
      {
        "id": "reduce_node",
        "op_type": "ReduceL2",
        "inputs": ["$x"],
        "outputs": ["$l2_out"]
      },
      {
        "id": "clip_node",
        "op_type": "Clip",
        "inputs": ["$l2_out", "$c_eps"],
        "outputs": ["$clip_out"]
      },
      {
        "id": "expand_node",
        "op_type": "Expand",
        "inputs": ["$clip_out", "$shape_x"],
        "outputs": ["$expand_out"]
      },
      {
        "id": "div_node",
        "op_type": "Div",
        "inputs": ["$x", "$expand_out"],
        "outputs": ["$div_out"]
      },
      {
        "id": "mul_scale_node",
        "op_type": "Mul",
        "inputs": ["$div_out", "$c_sqrt_d"],
        "outputs": ["$scaled_out"]
      },
      {
        "id": "mul_gamma_node",
        "op_type": "Mul",
        "inputs": ["$scaled_out", "$gamma"],
        "outputs": ["$out"]
      }
    ],
    "conditions": [
      {
        "type": "scalar_approx",
        "tensor": "$c_eps",
        "value": 1e-12,
        "tolerance": 1e-6
      }
    ]
  },
  "action": {
    "type": "fuse_to_function",
    "op_type": "RMSNorm",
    "domain": "custom.pytorch",
    "pytorch_module": "torch.nn.modules.normalization.RMSNorm",
    "inputs": ["$x", "$gamma"],
    "outputs": ["$out"],
    "attributes": {
      "epsilon": 1e-12
    }
  }
}
