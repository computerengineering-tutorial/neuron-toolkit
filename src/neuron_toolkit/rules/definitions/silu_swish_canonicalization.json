{
  "rule_id": "silu_swish_canonicalization",
  "name": "SiLU / Swish Canonicalization",
  "description": "Fuses x * Sigmoid(x) into SiLU .",
  "pattern": {
    "nodes": [
      {
        "id": "sig_node",
        "op_type": "Sigmoid",
        "inputs": [
          "$x"
        ],
        "outputs": [
          "$sig_out"
        ]
      },
      {
        "id": "mul_node",
        "op_type": "Mul",
        "inputs": [
          "$x",
          "$sig_out"
        ],
        "outputs": [
          "$y"
        ]
      }
    ]
  },
  "action": {
    "type": "replace_op",
    "op_type": "SiLU",
    "domain": "custom.pytorch",
    "inputs": [
      "$x"
    ],
    "outputs": [
      "$y"
    ],
    "targets": {
      "function_proto": {
        "op_type": "SiLU",
        "domain": "custom.pytorch",
        "inputs": [
          "$x"
        ]
      }
    }
  }
}
